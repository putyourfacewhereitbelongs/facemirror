{
  "name": "facemirror",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FaceMirror: webcam-driven 2.5D portrait puppet (MediaPipe 478-point mesh, rigid head pose, procedural oral cavity) plus the optional React/Vite studio workspace.",
  "scripts": {
    "dev": "node tools/build.mjs && node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "verify": "node tools/verify.mjs",
    "harness": "node tools/build.mjs && node tools/harness.mjs",
    "test": "node tools/build.mjs --check && node tools/verify.mjs && node tools/harness.mjs",
    "serve": "node tools/serve.mjs",
    "studio:dev": "vite --host 0.0.0.0",
    "studio:build": "tsc -b && vite build",
    "studio:test": "vitest run"
  },
  "dependencies": {
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "delaunator": "^5.1.0",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.3"
  }
}
